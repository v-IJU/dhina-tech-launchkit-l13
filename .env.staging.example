# STAGING settings: same compose.prod.yaml + deploy.sh as production, in its own folder, on a smaller server
# or next to production. Copy to .env in the staging folder (DEPLOY.md section 13):
#   git clone … /srv/app-staging && cd /srv/app-staging && cp .env.staging.example .env
#   DEPLOY_BRANCH=staging ./deploy.sh
# Differences from production are marked  ◀ STAGING.

APP_NAME="Your Business (staging)"                 # ◀ STAGING: shows in emails, tab title
APP_ENV=staging                                    # ◀ STAGING: noindex, Horizon "staging" supervisors
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://staging.CHANGE_ME.com              # ◀ STAGING

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# "cache" puts "php artisan down" in Redis, so every server behind a load balancer sees it.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

ADMIN_PATH=admin
BCRYPT_ROUNDS=12

# Logs: daily files in the storage volume + container output (docker compose logs).
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                                    # ◀ STAGING: more detail while testing
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------- Docker (compose.prod.yaml / deploy.sh)
COMPOSE_PROJECT_NAME=laravel13-staging             # ◀ STAGING: own containers, volumes and network
APP_IMAGE=laravel13-app-staging                    # ◀ STAGING: own images (deploy.sh cleanup never touches production's)
WEB_PORT=8081                                      # ◀ STAGING: production keeps 80 on a shared server
# Which optional containers run on THIS server (DEPLOY.md section 5):
#   mysql,redis  = everything on this server (staging / small sites)
#   redis        = RDS for the database + Redis container        ← recommended for one server
#   (empty)      = RDS + ElastiCache (several servers)
# With RDS: set DB_HOST to the RDS endpoint below. With ElastiCache: set REDIS_HOST too.
COMPOSE_PROFILES=mysql,redis                       # ◀ STAGING: its own small database + Redis on the box

# ---------------------------------------------------------------- Server sizing (DEPLOY.md section 5.2)
# Values for a 4 GB server running everything (t3.medium). 8 GB: 25 / 2G / 1gb / 10.
PHP_FPM_MAX_CHILDREN=5        # ◀ STAGING: few users
MYSQL_BUFFER_POOL=256M        # ◀ STAGING
REDIS_MAXMEMORY=128mb         # ◀ STAGING
HORIZON_MAX_PROCESSES=2       # ◀ STAGING

# ---------------------------------------------------------------- Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=starter_staging                        # ◀ STAGING: never the production database
DB_USERNAME=starter
DB_PASSWORD=CHANGE_ME
# Only for the bundled mysql container:
DB_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=starter_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Big Excel / CSV imports: own queue "imports" (one job of up to 1 hour). Horizon runs it (supervisor-imports).
# SQS instead of Redis: leave IMPORT_QUEUE_CONNECTION empty and create an SQS queue "imports" (visibility 3600 s).
IMPORT_QUEUE_CONNECTION=redis-imports
IMPORT_QUEUE=imports

# ---------------------------------------------------------------- Mail (e.g. AWS SES SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME.com"
MAIL_FROM_NAME="${APP_NAME}"
# ◀ STAGING: EVERY email goes here instead of the real recipient (subject gets "[STAGING]").
# Keep this set whenever staging has a copy of production data. Comma-separate several inboxes.
MAIL_ALWAYS_TO=qa@CHANGE_ME.com

# ---------------------------------------------------------------- Reverb (live notifications)
# Browsers connect to wss://APP_DOMAIN/app/... through the "web" container (no extra port to open).
REVERB_APP_ID=starter
REVERB_APP_KEY=CHANGE_ME_random_key
REVERB_APP_SECRET=CHANGE_ME_random_secret
REVERB_HOST=staging.CHANGE_ME.com                  # ◀ STAGING
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_INTERNAL_HOST=reverb
REVERB_INTERNAL_PORT=8080

# ---------------------------------------------------------------- Error monitoring (optional)
# Built-in: Admin > System > Errors (always on). Sentry as well: composer require sentry/sentry-laravel, then set:
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------- Uploaded files (media library, images, attachments): public = storage/app/public on this server,
# s3 = your S3 bucket (fill in AWS_* below). AWS_UPLOADS_PREFIX = folder inside the bucket.
UPLOADS_DISK=public
AWS_UPLOADS_PREFIX=staging/uploads                 # ◀ STAGING: same bucket, own folder (or a separate bucket)
# Team chat files are always private. Empty = s3 when UPLOADS_DISK=s3, otherwise storage/app/private/chat.
CHAT_DISK=
AWS_CHAT_PREFIX=staging/chat                       # ◀ STAGING

# ---------------------------------------------------------------- SaaS mode (see SAAS.md). false = single business. Turn on with: php artisan starter:install --mode=saas
# or convert an existing install: php artisan tenancy:convert. Needs CACHE_STORE=redis.
STARTER_TENANCY=false
# SaaS: the DB user needs CREATE DATABASE / DROP DATABASE rights (one database per tenant).
CENTRAL_DOMAIN=CHANGE_ME.com
CENTRAL_EXTRA_DOMAINS=
TENANT_DB_PREFIX=tenant_
SAAS_GRACE_DAYS=7
SAAS_CURRENCY=INR

# ---------------------------------------------------------------- AI (Admin > AI & MCP). Provider and key can also be set per site under Settings > AI.
# Only the provider you choose needs a key. Full list: config/ai.php
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------- Payment gateways for SaaS plans (switch each on/off under Settings > Billing)
# ◀ STAGING: TEST keys only (rzp_test_…, sk_test_…). Never live payment keys on staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Backups (spatie/laravel-backup)
# Where backups are stored. Keep a copy OFF the server: change to local,s3 after
#   filling in the AWS_* values below (DEPLOY.md section 9).
BACKUP_DISKS=local                                 # ◀ STAGING: no S3 backups needed
BACKUP_ARCHIVE_PASSWORD=CHANGE_ME
BACKUP_NOTIFY_EMAIL=CHANGE_ME@CHANGE_ME.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------- Staging lock  ◀ STAGING
# Browser login box in front of the whole site (website + admin), so the public and Google never see it.
# /up (health check) and payment webhooks stay open. Share it with the client: user:password
STAGING_BASIC_AUTH=client:CHANGE_ME

