<?php

declare(strict_types=1);

namespace App\Modules\__Module__\Controllers\Admin;

use App\Core\DataTable\DataTable;
use App\Core\Http\StoresUploads;
use App\Core\Export\TemplateExport;
use App\Core\Import\ImportRun;
use App\Http\Controllers\Controller;
use App\Modules\__Module__\Exports\__Model__Export;
use App\Modules\__Module__\Imports\__Model__Import;
use App\Modules\__Module__\Models\__Model__;
use App\Modules\__Module__\Requests\Store__Model__Request;
use App\Modules\__Module__\Requests\Update__Model__Request;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Routing\Controllers\HasMiddleware;
use Illuminate\Routing\Controllers\Middleware;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\Rule;
use Illuminate\View\View;
use Maatwebsite\Excel\Facades\Excel;
use Mews\Purifier\Facades\Purifier;
use Symfony\Component\HttpFoundation\BinaryFileResponse;
use Symfony\Component\HttpFoundation\Response;

class __Model__Controller extends Controller implements HasMiddleware
{
    use StoresUploads;

    /** @var array<int, string> File inputs saved to storage/app/public/__slug__ */
    private array $uploads = [__uploads__];

    /** @var array<int, string> Rich text fields cleaned with HTML Purifier */
    private array $richText = [__richText__];

    public static function middleware(): array
    {
        return [
            new Middleware('permission:__slug__.view', only: ['index']),
            new Middleware('permission:__slug__.create', only: ['create', 'store']),
            new Middleware('permission:__slug__.edit', only: ['edit', 'update', 'toggle']),
            new Middleware('permission:__slug__.delete', only: ['destroy', 'restore', 'forceDelete']),
            new Middleware('permission:__slug__.import', only: ['importForm', 'import', 'importTemplate']),
        ];
    }

    /**
     * List page. Search, sorting, filters, per-page, Excel/CSV export and bulk actions
     * all come from the query string; see app/Core/DataTable/DataTable.php.
     */
    public function index(Request $request): Response
    {
        return DataTable::of(__Model__::query(), $request)
            ->search([__searchColumns__])
            ->sortable([__sortColumns__], default: '__defaultSort__', direction: '__defaultDir__')
__filters__            ->dateRange('created_at')
            ->export('__slug__', __Model__Export::class, '__slug__.export')   // Exports/__Model__Export.php
            ->bulk(route('admin.__slug__.bulk'), [__bulkPermissions__])
            ->trash('__slug__.delete')
            ->render('__slug__::admin.index', '__slug__::admin._table');
    }

    public function create(): View
    {
        return view('__slug__::admin.create', ['__model__' => new __Model__, 'options' => $this->options()]);
    }

    public function store(Store__Model__Request $request): RedirectResponse
    {
        $data = $this->prepare($request, $request->validated());
        __Model__::create($data);

        return redirect()->route('admin.__slug__.index')->with('success', '__Singular__ created.');
    }

    public function edit(__Model__ $__model__): View
    {
        return view('__slug__::admin.edit', ['__model__' => $__model__, 'options' => $this->options()]);
    }

    public function update(Update__Model__Request $request, __Model__ $__model__): RedirectResponse
    {
        $data = $this->prepare($request, $request->validated(), $__model__);
        $__model__->update($data);

        return redirect()->route('admin.__slug__.index')->with('success', '__Singular__ updated.');
    }

    public function destroy(__Model__ $__model__): RedirectResponse
    {
        $__model__->delete();

        return back()->with('success', '__Singular__ moved to the trash.');
    }

    public function restore(__Model__ $__model__): RedirectResponse
    {
        $__model__->restore();

        return back()->with('success', '__Singular__ restored.');
    }

    public function forceDelete(__Model__ $__model__): RedirectResponse
    {
        $__model__->forceDelete(); // the model removes its uploaded files

        return back()->with('success', '__Singular__ deleted forever.');
    }

    /**
     * Bulk actions from the list page: __bulkList__.
     */
    public function bulk(Request $request): RedirectResponse
    {
        $data = $request->validate([
            'action' => ['required', Rule::in([__bulkActionList__, 'restore', 'force-delete'])],
            'ids' => ['required', 'array'],
            'ids.*' => ['integer'],
        ]);
        $needsDelete = in_array($data['action'], ['delete', 'restore', 'force-delete'], true);
        abort_unless($request->user()->can($needsDelete ? '__slug__.delete' : '__slug__.edit'), 403);

        $inTrash = in_array($data['action'], ['restore', 'force-delete'], true);
        $items = __Model__::query()->when($inTrash, fn ($q) => $q->onlyTrashed())->whereKey($data['ids'])->get();

        match ($data['action']) {
            'delete' => $items->each->delete(),
            'restore' => $items->each->restore(),
            'force-delete' => $items->each->forceDelete(),
            default => null,
        };
__bulkUpdate__
        $done = ['delete' => 'moved to the trash', 'restore' => 'restored', 'force-delete' => 'deleted forever'][$data['action']] ?? 'updated';

        return back()->with('success', $items->count()." item(s) {$done}.");
    }
__toggle__
    /*
    | Import (Excel / CSV). Columns and saving: Imports/__Model__Import.php
    */
    public function importForm(): View
    {
        return view('__slug__::admin.import', [
            'columns' => (new __Model__Import)->describe(),
            'runs' => ImportRun::recent('__slug__'),
        ]);
    }

    public function import(Request $request): RedirectResponse
    {
        $request->validate(['file' => ImportRun::fileRules(), 'dry_run' => ['nullable', 'boolean']]);

        $run = ImportRun::start('__slug__', $request->file('file'), $request->user(), dryRun: $request->boolean('dry_run'));
        $run->process(new __Model__Import($run));   // small file: now · big file: queued in chunks

        return redirect()->route('admin.__slug__.import')->with(
            $run->status === 'failed' ? 'error' : 'success',
            match (true) {
                $run->status === 'failed' => 'The file could not be imported: '.$run->message,
                $run->queued => 'Import started in the background ('.number_format($run->total_rows).' rows). You will get a notification when it is done.',
                $run->dry_run => 'Check finished, nothing was saved: '.$run->summary().'.',
                default => 'Import finished: '.$run->summary().'.',
            },
        );
    }

    public function importTemplate(): BinaryFileResponse
    {
        return Excel::download(new TemplateExport(new __Model__Import), '__slug__-import-template.xlsx');
    }

    /**
     * @param  array<string, mixed>  $data
     * @return array<string, mixed>
     */
    private function prepare(Request $request, array $data, ?__Model__ $__model__ = null): array
    {
        foreach ($this->richText as $field) {
            if (isset($data[$field])) {
                $data[$field] = Purifier::clean($data[$field]);
            }
        }

        return $this->storeUploads($request, $data, $this->uploads, '__slug__', $__model__);
    }

    /**
     * Options for select inputs (related records).
     *
     * @return array<string, mixed>
     */
    private function options(): array
    {
        return [
__options__
        ];
    }
}
