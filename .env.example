# Docker: project name + host ports. Change them to run a second copy of the project side by side.
COMPOSE_PROJECT_NAME=laravel13
APP_PORT=8080
FORWARD_DB_PORT=3307
FORWARD_PMA_PORT=8082
FORWARD_MAILPIT_PORT=8025
VITE_PORT=5173

APP_NAME="Your Business"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laravel Debugbar (dev only): bar at the bottom of every page with the views, queries, route, time.
# Empty = on when APP_DEBUG=true. Set false to hide it.
DEBUGBAR_ENABLED=
# Click a view / file in the bar to open it in your editor. Docker: map the container path to your folder.
DEBUGBAR_EDITOR=vscode
DEBUGBAR_REMOTE_SITES_PATH=/var/www/html
DEBUGBAR_LOCAL_SITES_PATH=
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Admin panel lives under this path, e.g. http://localhost:8080/admin
ADMIN_PATH=admin

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker compose service names are used as hosts
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=starter
DB_USERNAME=starter
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Big Excel imports: own queue "imports" (long jobs). Local Redis/Horizon: redis-imports.
# Production on SQS: leave empty and create an SQS queue named "imports" (visibility timeout 3600 s).
IMPORT_QUEUE_CONNECTION=redis-imports
IMPORT_QUEUE=imports
CACHE_STORE=redis
CACHE_PREFIX=starter_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches all mail locally: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb (WebSockets). The browser connects to REVERB_HOST:REVERB_PORT.
REVERB_APP_ID=starter
REVERB_APP_KEY=starter-key
REVERB_APP_SECRET=starter-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
# Inside Docker the app talks to the reverb container directly
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_INTERNAL_HOST=reverb
REVERB_INTERNAL_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Uploaded files (media library, images, attachments): public = storage/app/public on this server,
# s3 = your S3 bucket (fill in AWS_* below). AWS_UPLOADS_PREFIX = folder inside the bucket.
UPLOADS_DISK=public
AWS_UPLOADS_PREFIX=uploads
# Team chat files (images, documents, voice notes) are always private. local = storage/app/private/chat,
# s3 = your bucket under AWS_CHAT_PREFIX. Empty = s3 when UPLOADS_DISK=s3, otherwise local.
CHAT_DISK=
AWS_CHAT_PREFIX=chat

# SaaS mode (see SAAS.md). false = single business. Turn on with: php artisan starter:install --mode=saas
# or convert an existing install: php artisan tenancy:convert. Needs CACHE_STORE=redis.
STARTER_TENANCY=false
CENTRAL_DOMAIN=localhost
CENTRAL_EXTRA_DOMAINS=
TENANT_DB_PREFIX=tenant_
SAAS_GRACE_DAYS=7
SAAS_CURRENCY=INR

# AI (Admin > AI & MCP). Provider and key can also be set per site under Settings > AI.
# Only the provider you choose needs a key. Full list: config/ai.php
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Payment gateways for SaaS plans (switch each on/off under Settings > Billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Backups (spatie/laravel-backup)
BACKUP_DISKS=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=admin@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
