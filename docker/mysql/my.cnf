# MySQL settings for the bundled mysql container (COMPOSE_PROFILES=mysql). compose.prod.yaml mounts this file.
# Change it, then: docker compose -f compose.prod.yaml restart mysql
# The memory size is set from .env: MYSQL_BUFFER_POOL (compose.prod.yaml passes it on the command line).
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Connections: PHP-FPM workers + Horizon + scheduler + reverb, with room to spare.
max_connections = 150

# InnoDB: flush once a second instead of on every commit (much faster; at worst ~1 s of writes lost on a power cut).
innodb_flush_log_at_trx_commit = 2
innodb_log_buffer_size = 32M

# Binary logs: MySQL 8 keeps them 30 days by default and they quietly fill the disk.
# One server without replicas: keep 3 days (enough for point-in-time recovery from the nightly backup).
binlog_expire_logs_seconds = 259200

# Slow queries (> 1 s) go to a log: docker compose -f compose.prod.yaml exec mysql tail -f /var/lib/mysql/slow.log
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1

# Don't resolve client hostnames (faster connections from the other containers).
skip-name-resolve
